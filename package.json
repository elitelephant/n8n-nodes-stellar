{
  "name": "n8n-nodes-stellar",
  "version": "0.2.0",
  "description": "Sign Stellar transactions in n8n workflows",
  "keywords": [
    "n8n-community-node-package",
    "stellar",
    "xlm",
    "blockchain",
    "crypto",
    "cryptocurrency",
    "web3",
    "signing",
    "xdr"
  ],
  "license": "MIT",
  "homepage": "https://github.com/yripper/n8n-nodes-stellar#readme",
  "author": {
    "name": "coderipper",
    "email": "dev@joaquinsoza.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yripper/n8n-nodes-stellar.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "format": "prettier . --write",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/tsconfig.tsbuildinfo",
    "vendor/stellar-confidential-token-sdk/LICENSE",
    "vendor/stellar-confidential-token-sdk/VENDORED.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [
      "dist/credentials/StellarWalletApi.credentials.js",
      "dist/credentials/ConfidentialTokenHolderApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/StellarSigner/StellarSigner.node.js",
      "dist/nodes/Stellar/Stellar.node.js",
      "dist/nodes/StellarTrigger/StellarTrigger.node.js",
      "dist/nodes/ConfidentialToken/ConfidentialToken.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "dependencies": {
    "@aztec/bb.js": "0.87.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@noir-lang/noir_js": "1.0.0-beta.11",
    "@stellar/stellar-sdk": "17.1.0",
    "@zkpassport/poseidon2": "0.6.2",
    "stellar-sdk-14": "npm:@stellar/stellar-sdk@14.6.1"
  }
}
